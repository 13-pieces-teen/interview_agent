# SiliconFlow API Configuration
SILICONFLOW_API_KEY=your_api_key_here
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1

# Model Configuration
DEEPSEEK_MODEL=Pro/deepseek-ai/DeepSeek-V3.2
GLM_VISION_MODEL=zai-org/GLM-4.6V

# Output Configuration
OUTPUT_DIR=output
DATA_DIR=data

# Feishu (Lark) Export Configuration (Optional)
# Get your app credentials from: https://open.feishu.cn/app
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here
# For international version (Lark), use: https://open.larksuite.com/open-apis
FEISHU_API_BASE=https://open.feishu.cn/open-apis
